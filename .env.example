# Local dev uses SQLite — no external DB needed.
# For production, point this at Postgres (e.g. Supabase) and change the
# datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Generate a real secret for production: `openssl rand -base64 32`
NEXTAUTH_SECRET="dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Required for the AI tour finder (/api/ai/tour-search). Server-side only —
# never exposed to the browser. Without it, the AI search box on /search
# shows a friendly "temporarily unavailable" message; nothing else breaks.
ANTHROPIC_API_KEY=""
